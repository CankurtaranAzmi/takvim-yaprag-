# Takvim Yaprağı – Apache (cPanel) ayarları
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS ve www'suz alan adı
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://takvimyapragi.com%{REQUEST_URI} [L,R=301]

  # ——— Eski site adresleri (Google'ın bildiği eski URL'ler) ———
  # Eski gün adresleri (/27-Eylul, /27-Eylul/Olaylar, /27-Eylul/Tumu/3 ...): büyük harfli eski biçim.
  # Yeni sitede o günün sayfası varsa oraya 301, yoksa 410 (kalıcı olarak yok). Küçük harfli yeni adresler bu kurallara girmez.
  RewriteCond %{DOCUMENT_ROOT}/$1-ocak/index.html -f
  RewriteRule ^(\d{1,2})-Ocak(/.*)?$ /$1-ocak/ [L,R=301]
  RewriteCond %{DOCUMENT_ROOT}/$1-subat/index.html -f
  RewriteRule ^(\d{1,2})-Subat(/.*)?$ /$1-subat/ [L,R=301]
  RewriteCond %{DOCUMENT_ROOT}/$1-mart/index.html -f
  RewriteRule ^(\d{1,2})-Mart(/.*)?$ /$1-mart/ [L,R=301]
  RewriteCond %{DOCUMENT_ROOT}/$1-nisan/index.html -f
  RewriteRule ^(\d{1,2})-Nisan(/.*)?$ /$1-nisan/ [L,R=301]
  RewriteCond %{DOCUMENT_ROOT}/$1-mayis/index.html -f
  RewriteRule ^(\d{1,2})-Mayis(/.*)?$ /$1-mayis/ [L,R=301]
  RewriteCond %{DOCUMENT_ROOT}/$1-haziran/index.html -f
  RewriteRule ^(\d{1,2})-Haziran(/.*)?$ /$1-haziran/ [L,R=301]
  RewriteCond %{DOCUMENT_ROOT}/$1-temmuz/index.html -f
  RewriteRule ^(\d{1,2})-Temmuz(/.*)?$ /$1-temmuz/ [L,R=301]
  RewriteCond %{DOCUMENT_ROOT}/$1-agustos/index.html -f
  RewriteRule ^(\d{1,2})-Agustos(/.*)?$ /$1-agustos/ [L,R=301]
  RewriteCond %{DOCUMENT_ROOT}/$1-eylul/index.html -f
  RewriteRule ^(\d{1,2})-Eylul(/.*)?$ /$1-eylul/ [L,R=301]
  RewriteCond %{DOCUMENT_ROOT}/$1-ekim/index.html -f
  RewriteRule ^(\d{1,2})-Ekim(/.*)?$ /$1-ekim/ [L,R=301]
  RewriteCond %{DOCUMENT_ROOT}/$1-kasim/index.html -f
  RewriteRule ^(\d{1,2})-Kasim(/.*)?$ /$1-kasim/ [L,R=301]
  RewriteCond %{DOCUMENT_ROOT}/$1-aralik/index.html -f
  RewriteRule ^(\d{1,2})-Aralik(/.*)?$ /$1-aralik/ [L,R=301]
  RewriteRule ^\d{1,2}-(Ocak|Subat|Mart|Nisan|Mayis|Haziran|Temmuz|Agustos|Eylul|Ekim|Kasim|Aralik)(/.*)?$ - [G,L]

  # Eski numaralı olay/kişi adresleri (/10034/Orhan-Pamuk-..., /01/348/) ve eski WordPress yazıları (/2026/09/26/...): kalıcı olarak yok
  RewriteRule ^\d+/[^/]+/?$ - [G,L]
  RewriteRule ^\d{4}/\d{2}/\d{2}/.+$ - [G,L]

  # WordPress sistem adresleri, arşivler ve tema demo sayfaları: kalıcı olarak yok
  RewriteRule ^(category|tag|author|feed|comments|wp-admin|wp-login\.php|wp-content|wp-includes|wp-json|wp-sitemap[^/]*|xmlrpc\.php|index\.php)(/.*)?$ - [G,L]
  RewriteRule ^(sample-page(-2)?|masonry-[^/]+|grid-[^/]+|portfolio-[^/]+|gallery|typography|page-full-width|contact-information|privacy-policy-2)/?$ - [G,L]
  RewriteRule ^page/\d+/?$ - [G,L]
  RewriteCond %{QUERY_STRING} (^|&)(p|page_id|cat|tag|s|author|m)=
  RewriteRule ^$ - [G,L]
  RewriteRule ^about/?$ /hakkimizda/ [L,R=301]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
