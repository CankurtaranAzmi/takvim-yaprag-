---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { SITE } from '../site.config.mjs';

interface Props {
  baslik?: string;
  aciklama?: string;
  noindex?: boolean;
  tur?: 'website' | 'article';
  jsonld?: object | object[];
  aktif?: 'bugun' | 'takvim' | 'hakkimizda';
  gorsel?: string;
}

const { baslik, aciklama = SITE.aciklama, noindex = false, tur = 'website', jsonld, aktif, gorsel } = Astro.props;
const tamBaslik = baslik ? `${baslik} | ${SITE.ad}` : `${SITE.ad} – ${SITE.slogan}`;
const kanonik = new URL(Astro.url.pathname, Astro.site).href;
const yil = 2025;
const ldListe = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tamBaslik}</title>
  <meta name="description" content={aciklama} />
  <meta name="google-site-verification" content="fkkjgBL7Uk3m4ArIPkLIeCnoqhT9ZI1nK12ymu3EitA" />
  <link rel="canonical" href={kanonik} />
  <meta name="theme-color" content="#ffffff" />
  {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
  <meta name="author" content="Takvim Yaprağı" />
  <script is:inline>
    // Tema: varsayılan beyaz; kullanıcının seçimi hatırlanır. Boyamadan önce uygulanır ki sayfa yanıp sönmesin.
    try { if (localStorage.getItem('tema') === 'koyu') document.documentElement.dataset.tema = 'koyu'; } catch (e) {}
  </script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title="Takvim Yaprağı – Günlük" href="/rss.xml" />
  <link rel="manifest" href="/site.webmanifest" />

  <meta property="og:site_name" content={SITE.ad} />
  <meta property="og:locale" content="tr_TR" />
  <meta property="og:type" content={tur} />
  <meta property="og:title" content={baslik ?? SITE.ad} />
  <meta property="og:description" content={aciklama} />
  <meta property="og:url" content={kanonik} />
  {gorsel && <meta property="og:image" content={gorsel} />}
  <meta name="twitter:title" content={baslik ?? SITE.ad} />
  <meta name="twitter:description" content={aciklama} />
  <meta name="twitter:card" content={gorsel ? 'summary_large_image' : 'summary'} />
  <link rel="preconnect" href="https://upload.wikimedia.org" />
  <link rel="preconnect" href="https://thumb.wikimedia.org" />


  {ldListe.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}

  <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsense}`} crossorigin="anonymous"></script>
</head>
<body>
  <a class="atla" href="#icerik">İçeriğe geç</a>
  <header class="ust">
    <div class="kap">
      <a class="logo" href="/" aria-label={`${SITE.ad} ana sayfa`}>
        <Logo />
        <span class="logo-yazi">Takvim<span>Yaprağı</span></span>
      </a>
      <nav class="menu" aria-label="Ana menü">
        <a href="/" aria-current={aktif === 'bugun' ? 'page' : undefined}>Bugün</a>
        <a href="/takvim/" aria-current={aktif === 'takvim' ? 'page' : undefined}>Takvim</a>
        <a class="menu-ek" href="/hakkimizda/" aria-current={aktif === 'hakkimizda' ? 'page' : undefined}>Hakkımızda</a>
      </nav>
      <div class="ust-tarih"><span id="ust-bugun"></span></div>
      <button class="tema-dugme" type="button" aria-label="Koyu modu aç/kapat" title="Koyu mod">
        <svg class="ay" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="gunes" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </header>

  <main id="icerik">
    <slot />
  </main>

  <footer class="alt">
    <div class="kap">
      <div>
        <a class="logo" href="/"><Logo /><span class="logo-yazi">Takvim<span>Yaprağı</span></span></a>
        <p style="margin-top:12px">{SITE.aciklama}</p>
      </div>
      <div>
        <nav aria-label="Alt menü">
          <a href="/takvim/">Tüm Günler</a>
          <a href="/hakkimizda/">Hakkımızda</a>
          <a href="/iletisim/">İletişim</a>
          <a href="/gizlilik-politikasi/">Gizlilik</a>
          <a href="/cerez-politikasi/">Çerezler</a>
        </nav>
        <p>Olay listeleri <a href="https://tr.wikipedia.org" rel="noopener">Vikipedi</a> kaynaklıdır ve <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.tr" rel="license noopener">CC BY-SA 4.0</a> lisansıyla kullanılır. Görseller Wikimedia Commons'tan, her birinin altında belirtilen lisansla kullanılır. Özet yazılar yapay zekâ yardımıyla özgün olarak yeniden yazılır.</p>
        <p>© {yil} {SITE.ad}</p>
      </div>
    </div>
  </footer>
  <script is:inline>
    (function () {
      var kok = document.documentElement;
      var dugme = document.querySelector('.tema-dugme');
      var guncelle = function () {
        var koyu = kok.dataset.tema === 'koyu';
        dugme.setAttribute('aria-pressed', koyu ? 'true' : 'false');
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', koyu ? '#050607' : '#ffffff');
      };
      dugme.addEventListener('click', function () {
        if (kok.dataset.tema === 'koyu') delete kok.dataset.tema; else kok.dataset.tema = 'koyu';
        try { localStorage.setItem('tema', kok.dataset.tema === 'koyu' ? 'koyu' : 'acik'); } catch (e) {}
        guncelle();
      });
      guncelle();
      // Bugünün tarihi tarayıcıda yazılır; böylece her gece tüm sayfalar değişmez ve yayın sadece değişenleri yükler.
      try {
        var t = document.getElementById('ust-bugun');
        if (t) t.textContent = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', weekday: 'long', timeZone: 'Europe/Istanbul' }).format(new Date()).replace(/^(\d+) (\S+) (\S+)$/, '$1 $2 · $3');
      } catch (e) {}
    })();
  </script>
</body>
</html>
