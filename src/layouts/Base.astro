---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { SITE } from '../site.config.mjs';
import { istanbulBugun, AYLAR, GUNLER_HAFTA } from '../lib/tarih.mjs';

interface Props {
  baslik?: string;
  aciklama?: string;
  noindex?: boolean;
  tur?: 'website' | 'article';
  jsonld?: object | object[];
  aktif?: 'bugun' | 'takvim' | 'hakkimizda';
  gorsel?: string;
}

const { baslik, aciklama = SITE.aciklama, noindex = false, tur = 'website', jsonld, aktif, gorsel } = Astro.props;
const tamBaslik = baslik ? `${baslik} | ${SITE.ad}` : `${SITE.ad} – ${SITE.slogan}`;
const kanonik = new URL(Astro.url.pathname, Astro.site).href;
const yil = new Date().getFullYear();
const ldListe = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
const b = istanbulBugun();
const bugunYazi = `${b.gun} ${AYLAR[b.ay - 1]} · ${GUNLER_HAFTA[b.haftaGunu]}`;
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tamBaslik}</title>
  <meta name="description" content={aciklama} />
  <link rel="canonical" href={kanonik} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="theme-color" content="#0f1115" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta property="og:site_name" content={SITE.ad} />
  <meta property="og:locale" content="tr_TR" />
  <meta property="og:type" content={tur} />
  <meta property="og:title" content={baslik ?? SITE.ad} />
  <meta property="og:description" content={aciklama} />
  <meta property="og:url" content={kanonik} />
  {gorsel && <meta property="og:image" content={gorsel} />}
  <meta name="twitter:card" content={gorsel ? 'summary_large_image' : 'summary'} />
  <link rel="preconnect" href="https://upload.wikimedia.org" />
  <link rel="preconnect" href="https://thumb.wikimedia.org" />


  {ldListe.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}

  <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsense}`} crossorigin="anonymous"></script>
</head>
<body>
  <a class="atla" href="#icerik">İçeriğe geç</a>
  <header class="ust">
    <div class="kap">
      <a class="logo" href="/" aria-label={`${SITE.ad} ana sayfa`}>
        <Logo />
        <span class="logo-yazi">Takvim<span>Yaprağı</span></span>
      </a>
      <nav class="menu" aria-label="Ana menü">
        <a href="/" aria-current={aktif === 'bugun' ? 'page' : undefined}>Bugün</a>
        <a href="/takvim/" aria-current={aktif === 'takvim' ? 'page' : undefined}>Takvim</a>
        <a class="menu-ek" href="/hakkimizda/" aria-current={aktif === 'hakkimizda' ? 'page' : undefined}>Hakkımızda</a>
      </nav>
      <div class="ust-tarih"><span>{bugunYazi}</span></div>
    </div>
  </header>

  <main id="icerik">
    <slot />
  </main>

  <footer class="alt">
    <div class="kap">
      <div>
        <a class="logo" href="/"><Logo /><span class="logo-yazi">Takvim<span>Yaprağı</span></span></a>
        <p style="margin-top:12px">{SITE.aciklama}</p>
      </div>
      <div>
        <nav aria-label="Alt menü">
          <a href="/takvim/">Tüm Günler</a>
          <a href="/hakkimizda/">Hakkımızda</a>
          <a href="/iletisim/">İletişim</a>
          <a href="/gizlilik-politikasi/">Gizlilik</a>
          <a href="/cerez-politikasi/">Çerezler</a>
        </nav>
        <p>Olay listeleri <a href="https://tr.wikipedia.org" rel="noopener">Vikipedi</a> kaynaklıdır ve <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.tr" rel="license noopener">CC BY-SA 4.0</a> lisansıyla kullanılır. Görseller Wikimedia Commons'tan, her birinin altında belirtilen lisansla kullanılır. Özet yazılar editörlerimize aittir.</p>
        <p>© {yil} {SITE.ad}</p>
      </div>
    </div>
  </footer>
</body>
</html>
