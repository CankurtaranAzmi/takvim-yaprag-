---
import Base from '../../layouts/Base.astro';
import { AYLAR, gunAdi, gunSlug, yilYaz, istanbulBugun } from '../../lib/tarih.mjs';
import { TUM_YAYINDAKI_OLAYLAR, yayindakiOlaylar } from '../../lib/veri.mjs';
import { srcset, buyukUrl, altMetin, kisaYazar } from '../../lib/gorsel.mjs';
import { SITE } from '../../site.config.mjs';

export function getStaticPaths() {
  return TUM_YAYINDAKI_OLAYLAR.map((o) => ({ params: { slug: o.id }, props: { o } }));
}

const { o } = Astro.props;
const g = o.gunVeri;
const haber = o.tur === 'haber';
const paragraflar = o.ozet.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const aciklama = paragraflar[0].length > 155 ? paragraflar[0].slice(0, 152).replace(/\s+\S*$/, '') + '…' : paragraflar[0];
const ayniGun = yayindakiOlaylar(g).filter((x) => x.id !== o.id).slice(0, 6);
const buYil = istanbulBugun().yil;
const url = `${SITE.url}/olay/${o.id}/`;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': haber ? 'NewsArticle' : 'Article',
    headline: o.baslik,
    description: aciklama,
    inLanguage: 'tr',
    mainEntityOfPage: url,
    dateModified: g.guncelleme,
    author: { '@type': 'Organization', name: `${SITE.ad} Editörlüğü`, url: `${SITE.url}/hakkimizda/` },
    publisher: { '@type': 'Organization', name: SITE.ad, url: SITE.url },
    about: { '@type': 'Event', name: o.baslik, description: o.metin },
    ...(o.gorsel ? { image: buyukUrl(o.gorsel) } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: gunAdi(g.ay, g.gun), item: `${SITE.url}/${g.slug}/` },
      { '@type': 'ListItem', position: 2, name: o.baslik, item: url },
    ],
  },
];
---
<Base baslik={`${o.baslik} (${yilYaz(o.yil)})`} aciklama={aciklama} tur="article" jsonld={jsonld} gorsel={o.gorsel ? buyukUrl(o.gorsel) : undefined}>
  <section class:list={['manset', 'manset--olay', { 'manset--gorselsiz': !o.gorsel, 'manset--dikey': o.gorsel && o.gorsel.yukseklik > o.gorsel.genislik * 0.95 }]}>
    {o.gorsel && (
      <figure class="manset-gorsel" style={`--arka:url('${o.gorsel.kucukUrl}')`}>
        <img src={o.gorsel.url} srcset={srcset(o.gorsel)} sizes="100vw" alt={altMetin(o.gorsel, o.baslik)} fetchpriority="high" decoding="async" />
      </figure>
    )}
    <div class="kap">
      <div class="manset-panel">
        <nav class="yol" aria-label="Konum"><a href="/">Anasayfa</a> / <a href={`/${g.slug}/`}>{gunAdi(g.ay, g.gun)}</a>{o.kategori && <> / {o.kategori}</>}</nav>
        <div class="manset-ust" style="margin-bottom:6px">
          <div class="rozet" aria-hidden="true"><div class="rozet-ay">{AYLAR[g.ay - 1].slice(0, 3)}</div><div class="rozet-gun">{g.gun}</div></div>
          <div class="manset-yil">{yilYaz(o.yil)}{o.yil > 0 && <small>{buYil - o.yil} yıl önce</small>}</div>
        </div>
        <h1>{o.baslik}</h1>
        {o.gorsel && (
          <p class="manset-kredi" style="margin:14px 0 0">
            {o.gorsel.konu && <>{o.gorsel.konu}. </>}Görsel: <a href={o.gorsel.kaynak} rel="noopener">{kisaYazar(o.gorsel, 70)}</a>,
            {o.gorsel.lisansUrl ? <a href={o.gorsel.lisansUrl} rel="license noopener">{o.gorsel.lisans}</a> : o.gorsel.lisans}, Wikimedia Commons
          </p>
        )}
      </div>
    </div>
  </section>

  <div class:list={['kap', 'duzen', { 'duzen--tek': !ayniGun.length }]}>
    <article class="makale">
      <div class="makale-govde">
        {paragraflar.map((p) => <p>{p}</p>)}
      </div>
      <p class="kaynak-kutu">
        {haber ? (
          <>Haber kaynağı: <a href={o.haberKaynagi.url} target="_blank" rel="noopener nofollow">{o.haberKaynagi.ad}</a> ({yilYaz(o.yil)}).</>
        ) : (
          <>Olay kaydı: <a href={g.kaynak.url} rel="noopener">Vikipedi – {gunAdi(g.ay, g.gun)}</a> (CC BY-SA 4.0).</>
        )}
        Bu {haber ? 'haber' : 'özet'} {SITE.ad} editörlüğü tarafından yeniden yazılmıştır. Bir hata fark ederseniz <a href="/iletisim/">bize yazın</a>.
      </p>
      <a class="dugme" href={`/${gunSlug(g.ay, g.gun)}/`}><span>← {gunAdi(g.ay, g.gun)} gününün tamamı</span></a>
    </article>

    {ayniGun.length > 0 && (
    <aside class="yan">
      {(
        <section class="kutu">
          <h2>Aynı gün</h2>
          <ul class="mini-liste">
            {ayniGun.map((x) => (
              <li>
                <a href={`/olay/${x.id}/`}>
                  {x.gorsel ? <img src={x.gorsel.kucukUrl} alt="" width="64" height="64" loading="lazy" /> : <span class="mini-bos">{yilYaz(x.yil)}</span>}
                  <span><small>{yilYaz(x.yil)}</small>{x.baslik}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </aside>
    )}
  </div>
</Base>
