---
// Bir günün tüm içeriği: gün şeridi, manşet, istatistik bandı, olay kartları, yan sütun, gezinme.
import { AYLAR, GUNLER_HAFTA, gunSlug, gunAdi, gunAdiDe, komsuGun, yilYaz, istanbulBugun } from '../lib/tarih.mjs';
import { gunBul, oneCikan } from '../lib/veri.mjs';
import { srcset, altMetin, kisaYazar } from '../lib/gorsel.mjs';
import GunSec from './GunSec.astro';
import OlayKart from './OlayKart.astro';

interface Props { g: any; bugunMu?: boolean }
const { g, bugunMu = false } = Astro.props;

const bugun = istanbulBugun();
const buYil = bugun.yil;
const haftaGunu = GUNLER_HAFTA[new Date(Date.UTC(buYil, g.ay - 1, g.gun)).getUTCDay()];

const onceki = komsuGun(g.ay, g.gun, -1);
const sonraki = komsuGun(g.ay, g.gun, 1);

// Gün şeridi: seçili günün 7 gün öncesi ve sonrası
const serit = [];
for (let k = -7; k <= 7; k++) {
  let d = { ay: g.ay, gun: g.gun };
  for (let i = 0; i < Math.abs(k); i++) d = komsuGun(d.ay, d.gun, Math.sign(k));
  serit.push({ ...d, var: !!gunBul(d.ay, d.gun), secili: k === 0 });
}

const yayinda = (o: any) => o.durum === 'yayinda' && o.ozet;
const ilkParagraf = (s: string) => (s.split(/\n\s*\n/)[0] ?? s).trim();
const vitrin = oneCikan(g);
const kalan = g.olaylar.filter((o: any) => o !== vitrin); // yeniden eskiye sıralı
const turkiye = kalan.filter((o: any) => o.bolge === 'turkiye');
const dunya = kalan.filter((o: any) => o.bolge !== 'turkiye');
const ayKisa = (ay: number) => AYLAR[ay - 1].slice(0, 3);
const ILK = 10;
const dikey = (o: any) => !!o?.gorsel && o.gorsel.yukseklik > o.gorsel.genislik * 0.95;
---
<nav class="serit" aria-label="Günler">
  <ol>
    {serit.map((d) => (
      <li>
        {d.var
          ? <a href={`/${gunSlug(d.ay, d.gun)}/`} aria-current={d.secili ? 'page' : undefined}><b>{d.gun}</b><small>{ayKisa(d.ay)}</small></a>
          : <a aria-disabled="true" style="opacity:.35;pointer-events:none"><b>{d.gun}</b><small>{ayKisa(d.ay)}</small></a>}
      </li>
    ))}
  </ol>
</nav>

<section class:list={['manset', { 'manset--gorselsiz': !vitrin, 'manset--dikey': dikey(vitrin) }]}>
  {vitrin && (
    <figure class="manset-gorsel" style={`--arka:url('${vitrin.gorsel.kucukUrl}')`}>
      <img src={vitrin.gorsel.url} srcset={srcset(vitrin.gorsel)} sizes="100vw" alt={altMetin(vitrin.gorsel)} fetchpriority="high" decoding="async" />
    </figure>
  )}
  <div class="kap">
    <div class="manset-panel">
      <div class="manset-ust">
        <div class="rozet" aria-hidden="true"><div class="rozet-ay">{ayKisa(g.ay)}</div><div class="rozet-gun">{g.gun}</div></div>
        <h1>{bugunMu ? `Bugün tarihte · ${gunAdi(g.ay, g.gun)} ${haftaGunu}` : `${gunAdiDe(g.ay, g.gun)} tarihte ne oldu?`}</h1>
      </div>
      {vitrin ? (
        <>
          <div class="manset-yil">{yilYaz(vitrin.yil)}{vitrin.yil > 0 && <small>{buYil - vitrin.yil} yıl önce</small>}</div>
          {vitrin.tur === 'haber' ? (
            <>
              {vitrin.durum === 'yazildi' && vitrin.ozet ? (
                <h2><a href={`/olay/${vitrin.id}/`}>{vitrin.baslik}</a></h2>
              ) : (
                <h2>{vitrin.metin}</h2>
              )}
              {vitrin.ozet && <p>{ilkParagraf(vitrin.ozet)}</p>}
              <div class="manset-alt">
                {vitrin.durum === 'yazildi' && vitrin.ozet && <a class="dugme" href={`/olay/${vitrin.id}/`}><span>Devamını oku →</span></a>}
                <details class="manset-kredi">
                  <summary>ⓘ Kaynaklar</summary>
                  Haber kaynağı: <a href={vitrin.haberKaynagi.url} target="_blank" rel="noopener nofollow">{vitrin.haberKaynagi.ad}</a> · Görsel: <a href={vitrin.gorsel.kaynak} rel="noopener">{kisaYazar(vitrin.gorsel)}</a> · {vitrin.gorsel.lisans} · Wikimedia Commons
                </details>
              </div>
            </>
          ) : (
            <>
              {yayinda(vitrin) ? <h2><a href={`/olay/${vitrin.id}/`}>{vitrin.baslik}</a></h2> : <h2>{vitrin.metin}</h2>}
              {yayinda(vitrin) && <p>{ilkParagraf(vitrin.ozet)}</p>}
              <div class="manset-alt">
                {yayinda(vitrin) && <a class="dugme" href={`/olay/${vitrin.id}/`}><span>Devamını oku →</span></a>}
                <details class="manset-kredi">
                  <summary>ⓘ Kaynaklar</summary>
                  Görsel: <a href={vitrin.gorsel.kaynak} rel="noopener">{kisaYazar(vitrin.gorsel)}</a> · {vitrin.gorsel.lisans} · Wikimedia Commons
                </details>
              </div>
            </>
          )}
        </>
      ) : (
        <h2>{g.olaylar.length} olay, {g.dogumlar.length} doğum, {g.olumler.length} ölüm</h2>
      )}
    </div>
  </div>
</section>

<div class="bant">
  <div class="kap">
    <ul class="sayilar">
      <li><b>{g.olaylar.length}</b> olay</li>
      <li><b>{g.dogumlar.length}</b> doğum</li>
      <li><b>{g.olumler.length}</b> ölüm</li>
    </ul>
    {g.ozelGunler.length > 0 && (
      <ul class="etiketler" aria-label="Özel günler">
        {g.ozelGunler.map((o: string) => <li class="etiket">{o}</li>)}
      </ul>
    )}
  </div>
</div>

<div class="kap duzen">
  <div>
    {turkiye.length > 0 && (
      <section aria-labelledby="turkiye" class="olay-bolumu">
        <div class="bolum-baslik"><h2 id="turkiye">Türkiye'de bu gün</h2><span>{turkiye.length} olay</span></div>
        <ol class="kartlar">{turkiye.map((o: any) => <OlayKart o={o} buYil={buYil} />)}</ol>
      </section>
    )}
    {dunya.length > 0 && (
      <section aria-labelledby="dunya" class="olay-bolumu">
        <div class="bolum-baslik"><h2 id="dunya">Dünyada bu gün</h2><span>{dunya.length} olay</span></div>
        <ol class="kartlar">{dunya.map((o: any) => <OlayKart o={o} buYil={buYil} />)}</ol>
      </section>
    )}

    <nav class="gezinme" aria-label="Günler arası gezinme">
      {gunBul(onceki.ay, onceki.gun) ? <a href={`/${gunSlug(onceki.ay, onceki.gun)}/`}><span>← Önceki gün</span><strong>{gunAdi(onceki.ay, onceki.gun)}</strong></a> : <span />}
      {gunBul(sonraki.ay, sonraki.gun) ? <a href={`/${gunSlug(sonraki.ay, sonraki.gun)}/`}><span>Sonraki gün →</span><strong>{gunAdi(sonraki.ay, sonraki.gun)}</strong></a> : <span />}
    </nav>

    <p class="kaynak-kutu">
      Kaynak: <a href={g.kaynak.url} rel="noopener">Vikipedi – {gunAdi(g.ay, g.gun)}</a> (CC BY-SA 4.0).
      Son güncelleme: {new Date(g.guncelleme).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}.
    </p>
  </div>

  <aside class="yan">
    {g.dogumlar.length > 0 && (
      <section class="kutu">
        <h2>Bu gün doğanlar</h2>
        <ol class="kisiler">
          {[...g.dogumlar].reverse().slice(0, ILK).map((o: any) => <li><b>{yilYaz(o.yil)}</b><span>{o.metin}</span></li>)}
        </ol>
        {g.dogumlar.length > ILK && (
          <details>
            <summary>Tümünü göster ({g.dogumlar.length})</summary>
            <ol class="kisiler">
              {[...g.dogumlar].reverse().slice(ILK).map((o: any) => <li><b>{yilYaz(o.yil)}</b><span>{o.metin}</span></li>)}
            </ol>
          </details>
        )}
      </section>
    )}
    {g.olumler.length > 0 && (
      <section class="kutu">
        <h2>Bu gün ölenler</h2>
        <ol class="kisiler">
          {[...g.olumler].reverse().slice(0, ILK).map((o: any) => <li><b>{yilYaz(o.yil)}</b><span>{o.metin}</span></li>)}
        </ol>
        {g.olumler.length > ILK && (
          <details>
            <summary>Tümünü göster ({g.olumler.length})</summary>
            <ol class="kisiler">
              {[...g.olumler].reverse().slice(ILK).map((o: any) => <li><b>{yilYaz(o.yil)}</b><span>{o.metin}</span></li>)}
            </ol>
          </details>
        )}
      </section>
    )}
    <GunSec />
  </aside>
</div>
